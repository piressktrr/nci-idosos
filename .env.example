# Copie para .env e troque os valores de exemplo. O .env não vai para o Git.

# Django
# Gere a chave com:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=gere-uma-chave-local-aleatoria
DJANGO_DEBUG=True
# Listas separadas por vírgula, sem espaços.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para o CSRF, com esquema (em produção: https://seu-dominio).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Sessão: duração em segundos (padrão 28800 = 8 horas). Também expira ao fechar o navegador.
DJANGO_SESSION_COOKIE_AGE=28800

# Produção (só valem com DJANGO_DEBUG=False)
# HSTS em segundos: comece com 3600 e suba aos poucos (86400, 604800, 31536000).
DJANGO_SECURE_HSTS_SECONDS=3600
# Atrás de proxy reverso que termina o HTTPS: HTTP_X_FORWARDED_PROTO. Sem proxy, deixe vazio.
DJANGO_SECURE_PROXY_SSL_HEADER=
# E-mails que recebem avisos de erro 500, separados por vírgula.
DJANGO_ADMINS=

# E-mail. Vazio = console em desenvolvimento (DEBUG=True) e SMTP em produção.
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
DJANGO_SERVER_EMAIL=webmaster@localhost

# PostgreSQL: usado pelo Django e pelo docker-compose.yaml
# (o container é criado com este banco, usuário e senha e publicado nesta porta)
POSTGRES_DB=nci_dev
POSTGRES_USER=nci_dev
POSTGRES_PASSWORD=defina-uma-senha-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
