# Copie para .env e troque os valores de exemplo.

# Django
DJANGO_SECRET_KEY=gere-uma-chave-local-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: usado pelo Django e pelo docker-compose.yaml
# (o container é criado com este banco, usuário e senha e publicado nesta porta)
POSTGRES_DB=nci_dev
POSTGRES_USER=nci_dev
POSTGRES_PASSWORD=defina-uma-senha-local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
